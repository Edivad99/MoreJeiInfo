{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "sources": "https://github.com/Edivad99/MoreJeiInfo",
    "issues": "https://github.com/Edivad99/MoreJeiInfo/issues"
  },
  "license": "${mod_license}",
  "environment": "client",
  "entrypoints": {
    "fabric-datagen": [
      "edivad.morejeiinfo.data.DataGeneration"
    ],
    "client": [
      "edivad.morejeiinfo.MoreJeiInfo"
    ]
  },
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "java": ">=21"
  }
}
